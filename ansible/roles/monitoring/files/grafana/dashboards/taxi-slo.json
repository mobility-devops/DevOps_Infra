  "description": "prod 앱 SLO(아키텍처 8장: 가용성 99%, 0.5초 이내 95%)와 현재 트래픽. /actuator 요청은 뺀다. 30일 값은 기록 규칙(taxi_prod:*) 으로 계산한다.",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "30일 SLO (목표: 가용성 99%, 0.5초 이내 95%)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "가용성 (30일)",
      "description": "30일 동안 5xx 없이 응답한 요청 비율. 목표 99%. 기록 규칙이 생긴 10-11부터의 값이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum_over_time(taxi_prod:http_errors:rate5m[30d]) or vector(0)) / sum_over_time(taxi_prod:http_requests:rate5m[30d])",
          "legendFormat": "가용성",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.99,
                "color": "green"
              }
            ]
          },
          "mappings": [],
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 2
