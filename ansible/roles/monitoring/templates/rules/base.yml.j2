groups:
  - name: watchdog
    rules:
      - alert: Watchdog
        expr: vector(1)
        labels:
          severity: none
        annotations:
          summary: "모니터링 파이프라인 생존 신호 (항상 울림)"

  - name: machines
    rules:
      - alert: InstanceDown
        expr: up{job="node", zone="host"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "호스트 쪽 머신이 응답하지 않습니다"
          runbook_url: "{{ runbook_base_url }}/InstanceDown.md"

      - alert: LaptopTargetDown
        expr: up{job="node", zone="laptop"} == 0
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "노트북 또는 worker3이 응답하지 않습니다 (prod는 호스트 worker가 응답)"
          runbook_url: "{{ runbook_base_url }}/LaptopDown.md"

      - alert: LaptopLinkDown
        expr: node_network_carrier{instance="devops-server", device="{{ host_wired_nic }}"} == 0
        for: 30s
        labels:
          severity: warning
        annotations:
          summary: "호스트-노트북 랜선 연결이 끊겼습니다"
          runbook_url: "{{ runbook_base_url }}/LaptopDown.md"

      - alert: DiskAlmostFull
        expr: |
          node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|nsfs"}
            / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|nsfs"} < 0.15
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "디스크 남은 공간이 15% 미만입니다"
          runbook_url: "{{ runbook_base_url }}/DiskAlmostFull.md"

      - alert: DiskAlmostFull
        expr: |
          node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|nsfs"}
            / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|nsfs"} < 0.05
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "디스크 남은 공간이 5% 미만입니다"
          runbook_url: "{{ runbook_base_url }}/DiskAlmostFull.md"

      - alert: MemoryLow
        expr: node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes < 0.10
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "사용 가능한 메모리가 10% 미만입니다"
          runbook_url: "{{ runbook_base_url }}/MemoryLow.md"

  - name: mysql
    rules:
      - alert: MySQLDown
        expr: mysql_up == 0 or up{job="mysqld"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "MySQL 또는 mysqld_exporter가 응답하지 않습니다"
          runbook_url: "{{ runbook_base_url }}/MySQLDown.md"

      - alert: MySQLConnectionsHigh
        expr: mysql_global_status_threads_connected / mysql_global_variables_max_connections > 0.8
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "MySQL 연결 수가 max_connections의 80%를 넘었습니다"
          runbook_url: "{{ runbook_base_url }}/MySQLConnectionsHigh.md"
