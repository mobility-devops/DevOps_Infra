global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["localhost:9093"]

scrape_configs:
{% for job, port in [('prometheus', 9090), ('alertmanager', 9093), ('loki', 3100), ('grafana', 3000)] %}
  - job_name: {{ job }}
    static_configs:
      - targets: ["localhost:{{ port }}"]
        labels: { instance: mon-01, zone: host }
{% endfor %}

  - job_name: node
    static_configs:
{% for t in monitoring_node_targets %}
      - targets: ["{{ t.ip }}:9100"]
        labels: { instance: {{ t.name }}, zone: {{ t.zone }} }
{% endfor %}

  - job_name: mysqld
    static_configs:
{% for h in groups['db'] %}
      - targets: ["{{ hostvars[h].ansible_host }}:9104"]
        labels: { instance: {{ h }}, zone: host }
{% endfor %}
{% if prod_probe_host and prod_probe_path %}

  - job_name: blackbox-prod
    scrape_interval: 1m
    metrics_path: /probe
    params:
      module: [http_prod]
    static_configs:
      - targets: ["https://{{ prod_probe_ip }}{{ prod_probe_path }}"]
        labels: { instance: prod }
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - target_label: __address__
        replacement: 127.0.0.1:9115
{% endif %}
