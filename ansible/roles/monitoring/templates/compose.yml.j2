services:
  prometheus:
    image: prom/prometheus:{{ prometheus_version }}
    container_name: prometheus                          # docker exec/stop 에 쓰는 이름 고정 (기본은 monitoring-prometheus-1)
    network_mode: host                                  # Docker ports는 ufw를 우회하므로 쓰지 않음
    restart: unless-stopped
    mem_limit: {{ prometheus_mem_limit }}
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ prometheus_retention_time }}
      - --storage.tsdb.retention.size={{ prometheus_retention_size }}
      - --web.enable-remote-write-receiver              # Alloy push 수신
      - --web.enable-lifecycle                          # /-/reload 허용
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./rules:/etc/prometheus/rules:ro
      - prometheus_data:/prometheus

  alertmanager:
    image: prom/alertmanager:{{ alertmanager_version }}
    container_name: alertmanager
    network_mode: host
    restart: unless-stopped
    mem_limit: {{ alertmanager_mem_limit }}
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
      - --cluster.listen-address=                       # 단일 서버: 클러스터 포트(9094) 끔
    volumes:
      - ./alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - ./secrets/alertmanager:/etc/alertmanager/secrets:ro
      - alertmanager_data:/alertmanager

  loki:
    image: grafana/loki:{{ loki_version }}
    container_name: loki
    network_mode: host
    restart: unless-stopped
    mem_limit: {{ loki_mem_limit }}
    command: -config.file=/etc/loki/loki.yml
    volumes:
      - ./loki.yml:/etc/loki/loki.yml:ro
      - loki_data:/loki

  grafana:
    image: grafana/grafana:{{ grafana_version }}
    container_name: grafana
    network_mode: host
    restart: unless-stopped
    mem_limit: {{ grafana_mem_limit }}
    environment:
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana_admin_password
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
      - ./secrets/grafana/admin_password:/run/secrets/grafana_admin_password:ro
      - grafana_data:/var/lib/grafana

volumes:
  prometheus_data:
  alertmanager_data:
  loki_data:
  grafana_data:
